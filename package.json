{
  "name": "smart-chat",
  "version": "0.1.0",
  "description": "Minimal MCP-driven AI chat web tool for DeepSeek Harness: a single-file chat page over plain REST+SSE, bridged to the dsh agent loop; every tool comes from MCP servers.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "docs"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "chat"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2"
  },
  "scripts": {
    "test": "node test/unit.mjs && node test/servers.mjs && node test/bridge.mjs && node test/integration.mjs"
  }
}
